[Unit]
Description=herdr-resume: record agent sessions in herdr terminals for resume after restart

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr-resume watch --interval 15
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
